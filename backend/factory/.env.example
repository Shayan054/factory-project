# Optional local file: copy to .env in this folder (backend/factory/.env)
# Do not commit .env. Hosting uses dashboard env vars — leave them unchanged.

DEBUG=True
# SECRET_KEY=any-local-secret

# Leave DATABASE_URL unset to use local MySQL (XAMPP defaults in settings.py):
# NAME=factory_db, USER=root, PASSWORD=, HOST=localhost, PORT=3306
#
# Or set DATABASE_URL to use another DB locally:
# DATABASE_URL=mysql://root@127.0.0.1:3306/factory_db
