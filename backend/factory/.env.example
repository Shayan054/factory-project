# Local Django configuration template (Copy to .env for local development)
DEBUG=True
SECRET_KEY=your-local-dev-secret-key
DJANGO_ENV=local

# Database Configuration (Local PostgreSQL defaults)
DB_NAME=factory
DB_USER=postgres
DB_PASSWORD=your-postgres-password
DB_HOST=localhost
DB_PORT=5432

# Production Database URL (Optional, hosting providers set this)
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Allowed Hosts & CORS Configuration (Comma-separated origins for production)
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
